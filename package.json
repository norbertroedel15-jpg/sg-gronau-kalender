{
  "name": "vereinskalender-sg-gronau",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server/server.mjs",
    "server": "node --watch server/server.mjs",
    "admin": "node server/server.mjs --create-admin",
    "test": "node --test server/*.test.mjs cloudflare/*.test.mjs",
    "cf:dev": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "cf:check": "npm run build && wrangler deploy --dry-run",
    "cf:deploy": "node scripts/check-cloudflare-config.mjs && npm run build && wrangler deploy",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:migrate:remote": "node scripts/check-cloudflare-config.mjs && wrangler d1 migrations apply DB --remote",
    "cf:backup": "node scripts/check-cloudflare-config.mjs && node scripts/cloudflare-backup.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "^5.20261104.0-beta",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
